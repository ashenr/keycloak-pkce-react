# Keycloak Configuration
# Replace these values with your actual Keycloak server details

# Keycloak server URL (use HTTPS in production)
KEYCLOAK_URL=https://your-keycloak-domain.com

# Keycloak realm name
KEYCLOAK_REALM=your-realm-name

# Backend API CORS allowed origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173
