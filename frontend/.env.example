# Keycloak Configuration
# Replace these values with your actual Keycloak server details

# Keycloak server URL (use HTTPS in production)
VITE_KEYCLOAK_URL=https://your-keycloak-domain.com

# Keycloak realm name
VITE_KEYCLOAK_REALM=your-realm-name

# Keycloak client ID (must match the client configured in Keycloak)
VITE_KEYCLOAK_CLIENT_ID=your-client-id
